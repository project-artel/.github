# docker-compose.yml 옆에 .env로 복사한다. Docker Compose가 그 파일을 알아서 읽으므로
# export할 것은 없다.
#
#   cp .env.example .env
#
# 채워야 하는 것은 "필수" 아래 셋뿐이다. 그 밑은 전부 쓸 만한 기본값이 있고, 손대지 않은
# stack도 그대로 뜬다.

# ── 필수 ──────────────────────────────────────────────────────
# orchestration은 이 셋이 없으면 기동하지 않는다. application.yml에 기본값이 없어서,
# 기능이 일부 빠지는 것이 아니라 container가 기동 도중 종료한다.

# 32바이트 이상이어야 한다. 짧으면
# "ARTEL_JWT_SECRET must contain at least 32 bytes"로 기동에 실패한다.
#
#   openssl rand -base64 48
ARTEL_JWT_SECRET=

# 등록된 GitHub OAuth app. 로그인하려면 실제 app이 필요하지만 stack을 띄우는 데는
# 필요 없다 — 비어 있지만 않으면 server는 뜨고 로그인 흐름만 실패한다.
#
# 등록: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── model 접근 ────────────────────────────────────────────────
# agent는 이것이 없어도 뜨고 model 호출만 실패하므로, stack은 어느 쪽이든 올라온다.
# QA 런, 시나리오 저작, 지식 추출을 돌리기 전에 채운다. OPENROUTER_API_KEY는 같은 값을
# 받는 옛 이름이다.
LLM_API_KEY=

# ── image 태그 ────────────────────────────────────────────────
# image 넷 중 어느 빌드를 돌릴지 정한다. `develop`은 develop branch를 따라 움직이고,
# 40자리 commit sha는 한 빌드에 고정된다. 두 태그 모두 각 저장소의
# publish-container workflow가 올린다.
ARTEL_IMAGE_TAG=develop

# ── 호스트 포트 ───────────────────────────────────────────────
# 포트가 겹칠 때 바꾼다. ARTEL_ALLOWED_ORIGINS와 VITE_ORCHESTRATION_URL이
# docker-compose.yml에서 이 값들로부터 만들어지므로, frontend와 CORS가 알아서 따라온다.
#
# orchestration의 내부 포트 8081이 여기 없는 것은 의도한 것이다. 그 포트는 게시하지
# 않는다 — docker-compose.yml의 `ports` 블록 주석을 참고한다.
ORCHESTRATION_PORT=8080
AGENT_PORT=8000
CONSOLE_PORT=5173
ADMIN_PORT=5174

# ── database ──────────────────────────────────────────────────
# Postgres container를 만드는 값이자 orchestration에 넘기는 값이라 둘이 항상 같다.
# 첫 실행 뒤에 바꿔도 이미 만들어진 database의 이름이 바뀌지는 않는다 — volume에 옛
# 이름으로 들어 있다.
DB_NAME=artel
DB_USERNAME=postgres
DB_PASSWORD=postgres
